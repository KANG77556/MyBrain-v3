<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_today_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_task_summary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="미완료 할 일" android:textColor="#0F172A" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_task_refresh" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="새로고침" android:textColor="#64748B" android:textSize="10sp" />
    </LinearLayout>

    <TextView android:id="@+id/widget_task_lines" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:maxLines="3" android:text="남은 할 일이 없습니다." android:textColor="#334155" android:textSize="13sp" />

    <TextView android:id="@+id/widget_task_add" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center" android:text="＋ 할 일 추가" android:textColor="#1D4ED8" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
