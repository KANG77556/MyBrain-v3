<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPT·Gemini 클라우드 API와 동기화 기능을 위한 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 이상 알림 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 휴대전화 재부팅 완료 알림을 받기 위한 권한 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MyBrainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MyBrain AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- 앱 시작 시 알림 권한을 확인한 뒤 새 작업 홈을 엽니다. -->
        <activity
            android:name=".NotificationPermissionActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1.8.4 실기기 반응형 보정이 적용된 기본 작업 화면입니다. -->
        <activity
            android:name=".WorkspaceActivityV3"
            android:exported="false"
            android:label="MyBrain AI" />

        <!-- 1.8.3 달력 중심 새 디자인 작업 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivityV2"
            android:exported="false"
            android:label="MyBrain AI 1.8.3 화면" />

        <!-- 1.8.2 작업 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivity"
            android:exported="false"
            android:label="MyBrain AI 이전 화면" />

        <!-- 기존 핵심 기능과 비상용 규칙 분석기를 보관하는 내부 메인 화면입니다. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 기존 통합 입력과 공유 텍스트 수신을 유지하는 보조 화면입니다. -->
        <activity
            android:name=".IntegratedMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 클라우드 AI 공급자와 암호화 API 키를 설정하는 내부 화면입니다. -->
        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:label="MyBrain AI 설정" />

        <!-- 선택한 AI로 문장을 분석하고 결과를 확인하는 내부 화면입니다. -->
        <activity
            android:name=".AiInputActivity"
            android:exported="false"
            android:label="AI 메시지 분석" />

        <!-- 메인 화면의 백업·복원 메뉴로만 여는 내부 화면입니다. -->
        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:label="MyBrain 백업" />

        <!-- 예약된 시각에 실제 알림을 표시합니다. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- 재부팅 또는 앱 업데이트 후 저장된 알림을 자동 복구합니다. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 홈 화면에 오늘 일정과 할 일을 표시하는 위젯입니다. -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
    </application>
</manifest>
