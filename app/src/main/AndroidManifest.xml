<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPT·Gemini 클라우드 API와 동기화 기능을 위한 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 음성 메모 기능을 위한 마이크 권한 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 13 이상 알림 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 휴대전화 재부팅 완료 알림을 받기 위한 권한 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 음성 인식기와 시스템 카메라 앱을 안전하게 확인할 수 있도록 선언합니다. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".MyBrainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MyBrain AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- 앱 시작 시 알림 권한을 확인한 뒤 새 작업 홈을 엽니다. -->
        <activity
            android:name=".NotificationPermissionActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1.8.9 개인정보 보호 음성·OCR 입력이 적용된 기본 화면입니다. -->
        <activity
            android:name=".WorkspaceActivityV7"
            android:exported="false"
            android:label="MyBrain AI" />

        <!-- 개인정보 자동 마스킹과 긴 OCR 핵심 정리가 적용된 통합 입력 화면입니다. -->
        <activity
            android:name=".UnifiedQuickInputActivityV2"
            android:exported="false"
            android:label="안전한 빠른 입력"
            android:windowSoftInputMode="adjustResize" />

        <!-- 중간 음성 인식 결과와 재시도 상태를 앱 안에서 표시합니다. -->
        <activity
            android:name=".VoiceCaptureActivity"
            android:exported="false"
            android:label="음성으로 입력" />

        <!-- 1.8.8 통합 빠른 입력 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivityV6"
            android:exported="false"
            android:label="MyBrain AI 1.8.8 화면" />

        <!-- 기존 통합 입력 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".UnifiedQuickInputActivity"
            android:exported="false"
            android:label="빠른 입력"
            android:windowSoftInputMode="adjustResize" />

        <!-- 1.8.7 빠른 입력 선택 화면은 기존 기능 호환용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivityV5"
            android:exported="false"
            android:label="MyBrain AI 1.8.7 화면" />

        <!-- 음성·문서 촬영·사진 OCR을 실행하며 통합 입력창에 결과를 반환할 수 있습니다. -->
        <activity
            android:name=".QuickInputActivity"
            android:exported="false"
            android:label="새 기록" />

        <!-- 음성·OCR 추출 원문을 확인하고 수정하는 기존 화면입니다. -->
        <activity
            android:name=".QuickCaptureReviewActivity"
            android:exported="false"
            android:label="추출 내용 확인" />

        <!-- 1.8.5 전체 화면 입력과 목록 조작 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivityV4"
            android:exported="false"
            android:label="MyBrain AI 1.8.5 화면" />

        <!-- 새 항목 작성과 기존 항목 수정을 담당하는 전체 화면입니다. -->
        <activity
            android:name=".WorkItemEditorActivity"
            android:exported="false"
            android:label="항목 입력" />

        <!-- 읽기 전용 상세 화면입니다. -->
        <activity
            android:name=".WorkItemDetailActivity"
            android:exported="false"
            android:label="항목 상세" />

        <!-- 여러 항목 선택과 일괄 처리를 담당합니다. -->
        <activity
            android:name=".WorkItemManagerActivity"
            android:exported="false"
            android:label="항목 관리" />

        <!-- 1.8.4 실기기 반응형 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivityV3"
            android:exported="false"
            android:label="MyBrain AI 1.8.4 화면" />

        <!-- 1.8.3 달력 중심 새 디자인 작업 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivityV2"
            android:exported="false"
            android:label="MyBrain AI 1.8.3 화면" />

        <!-- 1.8.2 작업 화면은 복구용으로 유지합니다. -->
        <activity
            android:name=".WorkspaceActivity"
            android:exported="false"
            android:label="MyBrain AI 이전 화면" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".IntegratedMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:label="MyBrain AI 설정" />

        <!-- 실행 버튼을 입력창 바로 아래로 옮긴 실제 AI 분석 화면입니다. -->
        <activity
            android:name=".AiInputActivityV2"
            android:exported="false"
            android:label="AI 메시지 분석" />

        <!-- 기존 코드의 AiInputActivity 명시적 호출을 새 화면으로 연결합니다. -->
        <activity-alias
            android:name=".AiInputActivity"
            android:exported="false"
            android:label="AI 메시지 분석"
            android:targetActivity=".AiInputActivityV2" />

        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:label="MyBrain 백업" />

        <!-- 시스템 카메라가 앱 캐시의 촬영 파일에만 임시 접근하도록 합니다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/quick_capture_paths" />
        </provider>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
    </application>
</manifest>
