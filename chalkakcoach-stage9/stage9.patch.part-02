diff --git a/chalkak_v090_work/ChalkakCoach/app/src/test/java/kr/co/chalkakcoach/camera/SceneAutoFramingControllerTest.kt b/app/src/test/java/kr/co/chalkakcoach/camera/SceneAutoFramingControllerTest.kt
new file mode 100644
index 0000000..2cac5f9
--- /dev/null
+++ b/app/src/test/java/kr/co/chalkakcoach/camera/SceneAutoFramingControllerTest.kt
@@ -0,0 +1,121 @@
+package kr.co.chalkakcoach.camera
+
+import kr.co.chalkakcoach.subject.SceneSubject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SceneAutoFramingControllerTest {
+    @Test
+    fun smallCenteredFoodZoomsInGradually() {
+        val result = evaluate(SceneSubject.FOOD, area = 0.08f)
+        assertEquals(AutoFramingStatus.ADJUSTING, result.status)
+        assertTrue(result.shouldApplyZoom)
+        assertTrue(result.nextZoomRatio > 1f)
+        assertTrue(result.nextZoomRatio < 1.2f)
+    }
+
+    @Test
+    fun largeFoodZoomsOut() {
+        val result = evaluate(SceneSubject.FOOD, area = 0.75f, current = 2f)
+        assertEquals(AutoFramingStatus.ADJUSTING, result.status)
+        assertTrue(result.nextZoomRatio < 2f)
+    }
+
+    @Test
+    fun centeredFoodAtTargetAreaLocks() {
+        val result = evaluate(SceneSubject.FOOD, area = 0.38f, current = 1.7f)
+        assertEquals(AutoFramingStatus.LOCKED, result.status)
+        assertFalse(result.shouldApplyZoom)
+    }
+
+    @Test
+    fun offCenterObjectDoesNotZoomIn() {
+        val result = evaluate(SceneSubject.OBJECT, area = 0.06f, centerX = 0.83f, current = 1.5f)
+        assertTrue(result.nextZoomRatio <= 1.5f)
+    }
+
+    @Test
+    fun landscapeReturnsTowardWideView() {
+        val result = evaluate(SceneSubject.LANDSCAPE, area = 0.3f, current = 2f)
+        assertEquals(AutoFramingStatus.ADJUSTING, result.status)
+        assertTrue(result.nextZoomRatio < 2f)
+    }
+
+    @Test
+    fun landscapeAtMinimumLocks() {
